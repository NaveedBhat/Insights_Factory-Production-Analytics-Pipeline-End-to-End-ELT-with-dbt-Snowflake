# Credentials & Secrets  ⚠️  NEVER commit these
# =============================================================
profiles.yml
*.profiles.yml
ExampleProfiles.yml
.env
.env.*
*.env
secrets.yml
secrets.yaml

# Allow sanitized example templates (credentials must be redacted)
!ExampleProfiles.yml
!profiles.yml.example

